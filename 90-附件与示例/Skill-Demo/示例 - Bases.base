filters:
  and:
    - file.inFolder("90-附件与示例/Skill-Demo")
    - kind == "demo-task"
formulas:
  days_left: if(due, (date(due) - today()).days, "")
  priority_label: if(priority == 1, "High", if(priority == 2, "Medium", "Low"))
properties:
  status:
    displayName: Status
  formula.priority_label:
    displayName: Priority
  formula.days_left:
    displayName: Days Left
views:
  - type: table
    name: Task Table
    order:
      - file.name
      - status
      - formula.priority_label
      - due
      - formula.days_left
  - type: cards
    name: Task Cards
    order:
      - file.name
      - status
      - due
